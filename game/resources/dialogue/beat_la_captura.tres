[sub_resource type="Resource" id="Resource_7bv3a"]
script = ExtResource("6_ofart")
id = &"captura_open_plural_1"
speaker_id = &"rodriguez"
text_es = "No me miren así. Yo también tengo que llenar la planilla: tres copias, y no hay papel carbón."
text_en = "Don't look at me like that. I have to fill in the planilla too: three copies, and there's no carbon paper."

[sub_resource type="Resource" id="Resource_iv6v7"]
script = ExtResource("6_ofart")
id = &"captura_open_plural_2"
speaker_id = &"rodriguez"
text_es = "¿Saben cuántos he saca'o del agua este mes? Ni yo. La cifra la ponen allá arriba."
text_en = "Do you know how many I've pulled out of the water this month? Neither do I. The number gets set up there."

[sub_resource type="Resource" id="Resource_fw2k8"]
script = ExtResource("2_tfpqk")
