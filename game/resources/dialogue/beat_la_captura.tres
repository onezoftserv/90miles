[sub_resource type="Resource" id="Resource_nafec"]
script = ExtResource("6_ofart")
id = &"captura_car_singular"
speaker_id = &"rodriguez"
text_es = "El carro ese lo hundimos, como manda el reglamento. Me dolió más que a ti."
text_en = "We sank that car, as the regulations say. It hurt me more than you."
conditions = Array[ExtResource("4_gvtwb")]([SubResource("Resource_ftulg")])

[sub_resource type="Resource" id="Resource_0pk8e"]
script = ExtResource("4_gvtwb")
kind = 32
amount = 2.0

[sub_resource type="Resource" id="Resource_t70ey"]
script = ExtResource("6_ofart")
id = &"captura_car_plural"
speaker_id = &"rodriguez"
text_es = "El carro ese lo hundimos, como manda el reglamento. Me dolió más que a ustedes."
text_en = "We sank that car, as the regulations say. It hurt me more than all of you."
conditions = Array[ExtResource("4_gvtwb")]([SubResource("Resource_0pk8e")])

[sub_resource type="Resource" id="Resource_0awxu"]
script = ExtResource("6_ofart")
id = &"captura_car_acta"
speaker_id = &"rodriguez"
text_es = "Se hace constar el hundimiento del vehículo utilizado como embarcación."
text_en = "Let it be recorded that the vehicle used as a vessel was sunk."

[sub_resource type="Resource" id="Resource_t0myk"]
script = ExtResource("4_gvtwb")
kind = 32
negate = true
amount = 2.0

[sub_resource type="Resource" id="Resource_kkteq"]
script = ExtResource("6_ofart")
id = &"captura_return_singular"
speaker_id = &"rodriguez"
text_es = "Lo siento, de verdad. Las cifras son las cifras. Pa'trás, pa'l cayo de antes. Y da gracias que no es pa' Mariel."
text_en = "I'm sorry, really. The numbers are the numbers. Back you go, to the cayo before. And be thankful it's not Mariel."
emotion = 2
conditions = Array[ExtResource("4_gvtwb")]([SubResource("Resource_t0myk")])

[sub_resource type="Resource" id="Resource_q1dp0"]
script = ExtResource("4_gvtwb")
