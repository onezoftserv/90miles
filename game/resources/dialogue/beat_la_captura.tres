[sub_resource type="Resource" id="Resource_u3jmo"]
script = ExtResource("6_ofart")
id = &"captura_open_again_plural"
speaker_id = &"rodriguez"
text_es = "¿Ustedes otra vez? Mira, yo no estoy pa' esto. Ya los tengo en el acta de la semana pasada."
text_en = "You lot again? Look, I'm not up for this. I've already got you in last week's acta."
emotion = 3

[sub_resource type="Resource" id="Resource_87rpk"]
script = ExtResource("2_tfpqk")
