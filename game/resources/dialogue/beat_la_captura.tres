[sub_resource type="Resource" id="Resource_j1esc"]
script = ExtResource("6_ofart")
id = &"captura_release_1"
speaker_id = &"rodriguez"
text_es = "Bueno. Aquí no ha pasa'o na'. El acta dice 'sector sin novedad'."
text_en = "Fine. Nothing happened here. The acta says 'sector all clear'."

[sub_resource type="Resource" id="Resource_l3ruo"]
script = ExtResource("4_gvtwb")
kind = 32
negate = true
amount = 2.0

[sub_resource type="Resource" id="Resource_o5hca"]
script = ExtResource("6_ofart")
id = &"captura_release_singular"
speaker_id = &"rodriguez"
text_es = "Te dejo en el próximo cayo. Y si alguien pregunta, yo 'taba mirando pa'l otro la'o."
text_en = "I'll drop you at the next cayo. And if anyone asks, I was looking the other way."
conditions = Array[ExtResource("4_gvtwb")]([SubResource("Resource_l3ruo")])

[sub_resource type="Resource" id="Resource_xmxjy"]
script = ExtResource("4_gvtwb")
kind = 32
amount = 2.0

[sub_resource type="Resource" id="Resource_63axk"]
script = ExtResource("6_ofart")
id = &"captura_release_plural"
speaker_id = &"rodriguez"
text_es = "Los dejo en el próximo cayo. Y si alguien pregunta, yo 'taba mirando pa'l otro la'o."
text_en = "I'll drop you all at the next cayo. And if anyone asks, I was looking the other way."
conditions = Array[ExtResource("4_gvtwb")]([SubResource("Resource_xmxjy")])

[sub_resource type="Resource" id="Resource_jxn4j"]
