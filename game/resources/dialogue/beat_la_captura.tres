speaker_id = &"rodriguez"
text_es = "Lo siento, de verdad. Las cifras son las cifras. Pa'trás, pa'l cayo de antes. Y den gracias que no es pa' Mariel."
text_en = "I'm sorry, really. The numbers are the numbers. Back you go, to the cayo before. And be thankful it's not Mariel."
