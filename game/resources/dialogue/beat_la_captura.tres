[sub_resource type="Resource" id="Resource_5i5kf"]
script = ExtResource("6_ofart")
id = &"captura_open_again"
speaker_id = &"rodriguez"
text_es = "¿Tú otra vez? Mira, yo no estoy pa' esto. Ya te tengo en el acta de la semana pasada."
text_en = "You again? Look, I'm not up for this. I've already got you in last week's acta."
emotion = 3

[sub_resource type="Resource" id="Resource_ff3jm"]
