[sub_resource type="Resource" id="Resource_34s8m"]
script = ExtResource("6_ofart")
id = &"captura_plea_maestro_singular"
speaker_id = &"player"
text_es = "Capitán, con esta corriente usted sabe dónde termina un bote sin rumbo. Si me devuelve, mañana me saca del agua otra vez, y esa cifra no se la cuadra nadie."
text_en = "Captain, with this current you know where a boat with no heading ends up. Send me back and tomorrow you'll be pulling me out of the water again, and nobody can square that number."
conditions = Array[ExtResource("4_gvtwb")]([SubResource("Resource_nrpmk")])

