[sub_resource type="Resource" id="Resource_08yte"]
script = ExtResource("6_ofart")
id = &"captura_plea_medico_singular"
speaker_id = &"player"
text_es = "Capitán, con esa cara usted no duerme desde el lunes. Yo soy médico y se lo digo: suélteme en el próximo cayo, y usted no me vio."
text_en = "Captain, with that face you haven't slept since Monday. I'm a doctor and I'm telling you: let me off at the next cayo, and you never saw me."
conditions = Array[ExtResource("4_gvtwb")]([SubResource("Resource_uofdn")])

[sub_resource type="Resource" id="Resource_g0kg5"]
script = ExtResource("4_gvtwb")
kind = 32
amount = 2.0

[sub_resource type="Resource" id="Resource_rs8bc"]
script = ExtResource("6_ofart")
id = &"captura_plea_medico_plural"
speaker_id = &"player"
text_es = "Capitán, el muchacho de la proa tiene fiebre desde que subimos. Déjeme verlo, y usted no nos vio."
text_en = "Captain, the kid at the bow has had a fever since we came aboard. Let me see to him, and you never saw us."
conditions = Array[ExtResource("4_gvtwb")]([SubResource("Resource_g0kg5")])

