[resource]
script = ExtResource("1_layout")
description_es = "Una media luna de arena al sol: una choza en ruinas al norte, palmas en el arco, restos del naufragio en la curva de dentro y charcos de marea al sur. Aquí empieza todo."
description_en = "A crescent of sunbaked sand: a ruined hut in the north, palms along the arc, flotsam on the inner curve and tide pools in the south. Everything starts here."
