[sub_resource type="Resource" id="Resource_sign_r"]
script = ExtResource("4_sign")
glyph = "r"
text_es = "Un radio ruso sin pilas. Todavía tiene puesta la emisora oficial: lo único que funcionó siempre."
text_en = "A dead Russian radio, still tuned to the official station: the one thing that always worked."

[sub_resource type="Resource" id="Resource_sign_a"]
script = ExtResource("4_sign")
glyph = "a"
text_es = "«AQUÍ NO SE RINDE NADIE» — y debajo, en carbón: «ni se queda nadie tampoco»."
text_en = "‘NOBODY SURRENDERS HERE’, and under it, in charcoal: ‘nobody stays either’."

[sub_resource type="Resource" id="Resource_sign_c"]
script = ExtResource("4_sign")
glyph = "c"
text_es = "«VIGILANCIA REVOLUCIONARIA» — la pintura está tan vieja como la garita. La garita está vacía."
text_en = "‘REVOLUTIONARY VIGILANCE’. The paint is as old as the post. The post is empty."

[sub_resource type="Resource" id="Resource_sign_x"]
script = ExtResource("4_sign")
glyph = "x"
text_es = "Dos palos en cruz, clavados en la arena. Alguien quiere que alguien cave aquí."
text_en = "Two crossed sticks in the sand. Someone wants someone to dig here."

[resource]
script = ExtResource("1_layout")
description_es = "Una costa de playa y dunas con una laguna salobre al oeste y una punta de piedra al este, donde se pudre una garita de vigilancia con las consignas todavía pintadas. Desde aquí, en las noches claras, se ve el resplandor de La Habana."
description_en = "A coast of beach and dunes with a brackish lagoon in the west and a rocky point in the east, where a watch post rots with its slogans still painted. On clear nights you can see the glow of Havana from here."
