; Engine configuration file.
; Godot rewrites this file when settings change in the editor; keep edits minimal and reviewable.

config_version=5

[application]

config/name="90 Millas"
config/description="Co-op survival roguelite: Cuban balseros island-hop across the Florida Straits."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
NetManager="*res://scripts/autoload/net_manager.gd"
WeatherManager="*res://scripts/autoload/weather_manager.gd"
DialogueService="*res://scripts/autoload/dialogue_service.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input]

