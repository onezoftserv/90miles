[gd_resource type="Resource" script_class="RouteData" format=3]

[ext_resource type="Script" path="res://scripts/data/route_data.gd" id="1_route"]
[ext_resource type="Script" path="res://scripts/data/condition_data.gd" id="2_condition"]

[sub_resource type="Resource" id="Resource_wind"]
script = ExtResource("2_condition")
kind = 23
ref_id = &"trade_wind"

[sub_resource type="Resource" id="Resource_sail"]
script = ExtResource("2_condition")
kind = 2
ref_id = &"tarp"
scope = 4
consume = true

[resource]
script = ExtResource("1_route")
description_es = "Ruta de prueba: una tabla pa' cada uno."
description_en = "Test route: one board each."
requirements = Array[ExtResource("2_condition")]([SubResource("Resource_wind")])
rider_requirements = Array[ExtResource("2_condition")]([SubResource("Resource_sail")])
capacity_mode = 2
starter_kind = 3
starter_id = &"tarp"
starts_discovered = true
vessel = 6
vessel_integrity = 60
vessel_kept_on_arrival = false
duration_s = Vector2(60, 60)
dump_triggers = Array[int]([2, 1])
arrival_scatter_tiles = Vector2i(10, 20)
id = &"test_board"
name_es = "Tabla de prueba"
name_en = "Test board"
