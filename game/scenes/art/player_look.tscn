[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/art/player_look.gd" id="1_look"]
[ext_resource type="Shader" path="res://scenes/art/player_look.gdshader" id="2_shader"]
[ext_resource type="Texture2D" path="res://assets/art/palette/player_ramps.png" id="3_ramps"]
[ext_resource type="SpriteFrames" path="res://assets/art/characters/balsero_frames.tres" id="4_frames"]
[ext_resource type="SpriteFrames" path="res://assets/art/fx/dive_ripple.tres" id="5_ripple"]
[ext_resource type="PackedScene" path="res://scenes/art/shadow.tscn" id="6_shadow"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_look"]
resource_local_to_scene = true
shader = ExtResource("2_shader")
shader_parameter/slot_row = 1
shader_parameter/ramps = ExtResource("3_ramps")
shader_parameter/water_line_on = false
shader_parameter/water_line_y = 4.0
shader_parameter/foam_color = Color(1, 1, 1, 1)

[node name="Look" type="Node2D" groups=["art_view"]]
script = ExtResource("1_look")

[node name="Shadow" parent="." instance=ExtResource("6_shadow")]
position = Vector2(0, 1.5)

[node name="Sprite" type="AnimatedSprite2D" parent="."]
texture_filter = 1
material = SubResource("ShaderMaterial_look")
sprite_frames = ExtResource("4_frames")
animation = &"idle_down"
centered = false
offset = Vector2(-16, -27)

[node name="Ripple" type="AnimatedSprite2D" parent="."]
visible = false
texture_filter = 1
sprite_frames = ExtResource("5_ripple")
animation = &"dive"
