[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/player/player.gd" id="1_body"]
[ext_resource type="Script" path="res://scripts/components/survival_meters.gd" id="2_meters"]
[ext_resource type="Script" path="res://scripts/player/player_input.gd" id="3_input"]
[ext_resource type="Texture2D" path="res://assets/art/characters/player_placeholder.png" id="4_sprite"]

[ext_resource type="Script" path="res://scripts/interaction/drag_handle.gd" id="5_drag"]
[ext_resource type="Script" path="res://scripts/net/player_net.gd" id="6_net"]

[sub_resource type="CircleShape2D" id="CircleShape2D_body"]
radius = 6.0

[sub_resource type="SceneReplicationConfig" id="SceneReplicationConfig_state"]
properties/0/path = NodePath("PlayerNet:net_position")
properties/0/spawn = true
properties/0/replication_mode = 1
properties/1/path = NodePath("PlayerNet:net_energy")
properties/1/spawn = true
properties/1/replication_mode = 1
properties/2/path = NodePath("PlayerNet:net_ack_seq")
properties/2/spawn = true
properties/2/replication_mode = 1
properties/3/path = NodePath("PlayerNet:net_model_state")
properties/3/spawn = true
properties/3/replication_mode = 1
properties/4/path = NodePath("PlayerNet:net_movement")
properties/4/spawn = true
properties/4/replication_mode = 1
properties/5/path = NodePath("PlayerNet:net_stealth")
properties/5/spawn = true
properties/5/replication_mode = 1
properties/6/path = NodePath("PlayerNet:net_downed")
properties/6/spawn = true
properties/6/replication_mode = 1

[node name="Player" type="CharacterBody2D"]
collision_layer = 2
collision_mask = 1
script = ExtResource("1_body")

[node name="Sprite" type="Sprite2D" parent="."]
texture_filter = 1
texture = ExtResource("4_sprite")

[node name="CollisionShape" type="CollisionShape2D" parent="."]
shape = SubResource("CircleShape2D_body")

[node name="SurvivalMeters" type="Node" parent="."]
script = ExtResource("2_meters")

[node name="PlayerInput" type="Node" parent="."]
script = ExtResource("3_input")

[node name="Camera" type="Camera2D" parent="."]

[node name="DragHandle" type="Node2D" parent="."]
script = ExtResource("5_drag")

[node name="PlayerNet" type="Node" parent="."]
script = ExtResource("6_net")

[node name="StateSync" type="MultiplayerSynchronizer" parent="."]
replication_interval = 0.05
replication_config = SubResource("SceneReplicationConfig_state")
