[gd_resource type="Resource" script_class="DecorArtData" format=3]

[ext_resource type="Script" path="res://scripts/art/decor_art_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/art/decor_look.gd" id="2_look"]
[ext_resource type="Texture2D" path="res://assets/art/structures/fire.png" id="3_fire"]
[ext_resource type="Texture2D" path="res://assets/art/fx/decor_cigar.png" id="4_cigar"]
[ext_resource type="Texture2D" path="res://assets/art/decals/decor_drag.png" id="5_drag"]
[ext_resource type="Texture2D" path="res://assets/art/structures/decor_post.png" id="6_post"]
[ext_resource type="Texture2D" path="res://assets/art/fx/post_ripple.png" id="7_ripple"]
[ext_resource type="Texture2D" path="res://assets/art/decals/decor_rope.png" id="8_rope"]
[ext_resource type="Texture2D" path="res://assets/art/creatures/platino.png" id="9_platino"]

[sub_resource type="AtlasTexture" id="AtlasTexture_embers"]
atlas = ExtResource("3_fire")
region = Rect2(64, 0, 16, 16)

[sub_resource type="AtlasTexture" id="AtlasTexture_smoke_0"]
atlas = ExtResource("4_cigar")
region = Rect2(0, 0, 16, 16)

[sub_resource type="AtlasTexture" id="AtlasTexture_smoke_1"]
atlas = ExtResource("4_cigar")
region = Rect2(16, 0, 16, 16)

[sub_resource type="SpriteFrames" id="SpriteFrames_smoke"]
animations = [{
"frames": [{
"duration": 1.0,
"texture": SubResource("AtlasTexture_smoke_0")
}, {
"duration": 1.0,
"texture": SubResource("AtlasTexture_smoke_1")
}],
"loop": true,
"name": &"smoke",
"speed": 3.0
}]

[sub_resource type="Resource" id="Resource_embers"]
script = ExtResource("2_look")
decor_id = &"embers"
texture = SubResource("AtlasTexture_embers")
offset = Vector2(0, -6)

[sub_resource type="Resource" id="Resource_cigar"]
script = ExtResource("2_look")
decor_id = &"cigar_smoke"
upright = true
frames = SubResource("SpriteFrames_smoke")

[sub_resource type="Resource" id="Resource_drag"]
script = ExtResource("2_look")
decor_id = &"drag_mark"
texture = ExtResource("5_drag")
pair = true

[sub_resource type="Resource" id="Resource_drag_wet"]
script = ExtResource("2_look")
decor_id = &"drag_mark"
terrain = 1

[sub_resource type="Resource" id="Resource_post"]
script = ExtResource("2_look")
decor_id = &"post"
upright = true
texture = ExtResource("6_post")

[sub_resource type="Resource" id="Resource_post_wet"]
script = ExtResource("2_look")
decor_id = &"post"
terrain = 1
upright = true
texture = ExtResource("6_post")
foot = ExtResource("7_ripple")

[sub_resource type="Resource" id="Resource_rope"]
script = ExtResource("2_look")
decor_id = &"cut_line"
texture = ExtResource("8_rope")

[sub_resource type="Resource" id="Resource_platino"]
script = ExtResource("2_look")
decor_id = &"platino"
upright = true
texture = ExtResource("9_platino")

[resource]
script = ExtResource("1_data")
looks = Array[ExtResource("2_look")]([SubResource("Resource_embers"), SubResource("Resource_cigar"), SubResource("Resource_drag"), SubResource("Resource_drag_wet"), SubResource("Resource_post"), SubResource("Resource_post_wet"), SubResource("Resource_rope"), SubResource("Resource_platino")])
