[gd_resource type="Resource" script_class="CreatureArt" format=3]

[ext_resource type="Script" path="res://scripts/art/creature_art.gd" id="1_art"]
[ext_resource type="Script" path="res://scripts/art/creature_art_entry.gd" id="2_entry"]

[sub_resource type="Resource" id="Resource_shark"]
script = ExtResource("2_entry")
foot_px = 9.0
has_shadow = false
water_line = true
water_line_px = 9.0
one_shots = Dictionary[StringName, StringName]({
&"retreat": &"strike"
})

[sub_resource type="Resource" id="Resource_crab"]
script = ExtResource("2_entry")
foot_px = 5.0
shadow_size = 1
shadow_y_px = 4.0

[sub_resource type="Resource" id="Resource_gull"]
script = ExtResource("2_entry")
foot_px = 5.0
shadow_size = 2
shadow_y_px = 4.0
airborne_states = PackedStringArray("swoop", "flee", "return")
air_lift_px = 8.0
perch_state = &"perch"
perch_lift_px = 34.0

[resource]
script = ExtResource("1_art")
entries = Dictionary[StringName, Resource]({
&"land_crab": SubResource("Resource_crab"),
&"reef_shark": SubResource("Resource_shark"),
&"seagull": SubResource("Resource_gull")
})
